utine nfa__reallocate_transition_forward (self) Arguments Type Intent Optional Attributes Name class( nfa_state_node_t ), intent(inout) :: self Source Code type , public :: nfa_state_node_t integer ( int32 ) :: own_i type ( nfa_transition_t ), allocatable :: forward (:) integer ( int32 ) :: forward_top = 1 integer ( int32 ) :: alloc_count_f = ALLOC_COUNT_INITTIAL contains procedure :: nfa__add_transition , nfa__add_transition_cube generic :: add_transition => nfa__add_transition , nfa__add_transition_cube procedure :: realloc_forward => nfa__reallocate_transition_forward procedure :: merge_segment => nfa__merge_segments_of_transition end type nfa_state_node_t","tags":"","url":"type/nfa_state_node_t.html"},{"title":"nfa_transition_t – Forgex—Fortran Regular Expression ","text":"type, public :: nfa_transition_t Components Type Visibility Attributes Name Initial type( cube_t ), public :: c integer(kind=int32), public :: dst = NFA_NULL_TRANSITION logical, public :: is_registered = .false. integer(kind=int32), public :: own_j = NFA_NULL_TRANSITION Source Code type , public :: nfa_transition_t type ( cube_t ) :: c integer ( int32 ) :: dst = NFA_NULL_TRANSITION integer ( int32 ) :: own_j = NFA_NULL_TRANSITION logical :: is_registered = . false . end type nfa_transition_t","tags":"","url":"type/nfa_transition_t.html"},{"title":"character_array_element_t – Forgex—Fortran Regular Expression ","text":"type, private :: character_array_element_t This type is wrapper to make a allocatable character array with variable length. Components Type Visibility Attributes Name Initial character(len=:), public, allocatable :: c Source Code type character_array_element_t character (:), allocatable :: c end type character_array_element_t","tags":"","url":"type/character_array_element_t.html"},{"title":"literal_t – Forgex—Fortran Regular Expression ","text":"type, private :: literal_t This type contains a character variables that represents each literal:\nall, pref, suff, and fact. Components